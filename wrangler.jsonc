{
  "name": "dev-site",
  "compatibility_date": "2026-07-19",
  // Site is served on the codelit.app custom domain only. Disable the
  // *.workers.dev subdomain and per-version preview URLs so there's a single
  // canonical URL (no duplicate-content / stray public hostnames).
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./out"
  }
}
